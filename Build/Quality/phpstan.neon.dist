includes:
  - ../../.Build/vendor/psbits/qa/Resources/Quality/phpstan.neon
  - ../../.Build/vendor/saschaegerer/phpstan-typo3/extension.neon

parameters:
  tmpDir: .phpstan
  paths:
    - ../../Classes
    - ../../Tests/Unit

  ignoreErrors:
      -
        identifier: trait.unused
        path: ../../Classes/Traits/ControllerCacheTrait.php
      # LanguageServiceFactoryTest compares our factory with the core factory by
      # design; the analyser resolves the string constants and would report the
      # comparison as always true.
      -
        identifier: function.alreadyNarrowedType
        path: ../../Tests/Unit/Service/Typo3/LanguageServiceFactoryTest.php
        reportUnmatched: false
      -
        identifier: staticMethod.alreadyNarrowedType
        path: ../../Tests/Unit/Service/Typo3/LanguageServiceFactoryTest.php
        reportUnmatched: false
      # addPageTSConfig() and addUserTSConfig() were removed from ExtensionManagementUtility in v14.
      # The calls are version-gated to v13, so on v14 the analyser still reports them as unknown even
      # though they are never executed. Matching by method name keeps the services fully analysed.
      -
        identifier: staticMethod.notFound
        message: '#addPageTSConfig#'
        reportUnmatched: false
      -
        identifier: staticMethod.notFound
        message: '#addUserTSConfig#'
        reportUnmatched: false
      # The upgrade wizard is a v13 placeholder without the wizard methods; the test file's calls and
      # instantiation are version-gated to v14, where the analyser resolves the real class and the
      # entries stay unmatched.
      -
        identifier: method.notFound
        message: '#ListTypeToCTypeUpdate::(getTitle|getDescription)#'
        reportUnmatched: false
      -
        identifier: new.noConstructor
        message: '#ListTypeToCTypeUpdate#'
        reportUnmatched: false





  excludePaths:
    # Static analysis covers the shipped code and the unit tests. The functional tests need a booted
    # testing framework instance (database, instance path, container) and are verified by the
    # test:functional matrix jobs instead, so they are deliberately out of the analyser's scope.
    - ../../Tests/Functional
    # The factory is declared conditionally: the core LanguageServiceFactory is a readonly class on
    # v14 but a plain class on v13, and a child must carry the same readonly status as its parent.
    # On each major the branch meant for the other major is an invalid (non-ignorable) extension, so
    # the file is left to the functional suites, which exercise it on every supported major.
    - ../../Classes/Service/Typo3/LanguageServiceFactory.php
    # The wizard is declared conditionally: the real class is only available on v14, where the core
    # provides the upgrade wizard infrastructure (AbstractListTypeToCTypeUpdate, UpgradeWizard
    # attribute); on v13 a placeholder keeps the class present for the DI container. On each major
    # the branch meant for the other major is an invalid (non-ignorable) extension, so the file is
    # left to the test suites, which exercise it on v14 and skip it on v13.
    - ../../Classes/Upgrade/ListTypeToCTypeUpdate.php
