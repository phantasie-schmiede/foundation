{
    "name": "psbits/foundation",
    "description": "Configuration framework for TYPO3 extension development",
    "license": "GPL-3.0-or-later",
    "type": "typo3-cms-extension",
    "keywords": [
        "configuration",
        "development",
        "extension",
        "typo3"
    ],
    "authors": [
        {
            "name": "Daniel Ablass",
            "email": "dn@phantasie-schmiede.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-fileinfo": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-simplexml": "*",
        "typo3/cms-backend": "^13.4 || ^14.3",
        "typo3/cms-core": "^13.4 || ^14.3"
    },
    "require-dev": {
        "psbits/crafter": "@dev",
        "psbits/qa": "@dev",
        "psbitstest/pluginfixture": "@dev",
        "psbitstest/tcafixture": "@dev",
        "roave/security-advisories": "dev-latest"
    },
    "suggest": {
        "psbits/crafter": "Code and file generator for PSBits TYPO3 extensions",
        "psbits/qa": "Shared QA tooling for the generated extensions: QA scripts, pre-commit hook and CI workflow (installed via qa sync)"
    },
    "repositories": [
        {
            "type": "path",
            "url": "./Tests/Functional/Fixtures/Extensions/*"
        }
    ],
    "autoload": {
        "psr-4": {
            "PSBits\\Foundation\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PSBits\\Foundation\\Tests\\": "Tests"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "vendor-dir": ".Build/vendor"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "foundation",
            "web-dir": ".Build/public"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "npm install",
            ".Build/bin/qa sync"
        ],
        "post-update-cmd": [
            ".Build/bin/qa sync"
        ],
        "analyze:php": "phpstan analyse --configuration=Build/Quality/phpstan.neon.dist --no-progress",
        "audit:composer": "composer audit --abandoned=report",
        "docker:images": [
            "Composer\\Config::disableProcessTimeout",
            "sh .Build/vendor/psbits/qa/Resources/Testing/Scripts/buildTestImages.sh"
        ],
        "fix:all": [
            "@fix:classes",
            "@fix:composer",
            "@fix:htmlxml",
            "@fix:json",
            "@fix:throws",
            "@fix:xlf",
            "@fix:php"
        ],
        "fix:classes": "npm run fix:classes",
        "fix:composer": "composer normalize",
        "fix:htmlxml": "npm run fix:htmlxml",
        "fix:json": "npm run fix:json",
        "fix:php": "php-cs-fixer fix --config=Build/Quality/.php-cs-fixer.dist.php --verbose",
        "fix:throws": ".Build/bin/qa throws-fix",
        "fix:xlf": ".Build/bin/qa xlf-fix",
        "lint:all": [
            "@analyze:php",
            "@audit:composer",
            "@lint:classes",
            "@lint:composer",
            "@lint:htmlxml",
            "@lint:json",
            "@lint:php",
            "@lint:typoscript",
            "@lint:xlf",
            "@lint:yaml",
            "@validate:composer"
        ],
        "lint:classes": "npm run lint:classes",
        "lint:composer": "composer normalize --dry-run --diff --no-check-lock --no-update-lock",
        "lint:htmlxml": "npm run lint:htmlxml",
        "lint:json": "npm run lint:json",
        "lint:php": "php-cs-fixer fix --config=Build/Quality/.php-cs-fixer.dist.php --dry-run --diff --verbose",
        "lint:typoscript": "typoscript-lint --config=.Build/vendor/psbits/qa/Resources/Quality/typoscript-lint.yml --ansi Configuration/TypoScript",
        "lint:xlf": ".Build/bin/qa xlf-check",
        "lint:yaml": "yamllint -c .Build/vendor/psbits/qa/Resources/Quality/yamllint.yml Configuration",
        "qa": [
            "@fix:all",
            "@lint:all",
            "@test:all"
        ],
        "test:all": [
            "@test:unit",
            "@test:functional",
            "@test:local",
            "@test:docker"
        ],
        "test:coverage": "sh .Build/vendor/psbits/qa/Resources/Testing/Scripts/runCoverage.sh @additional_args",
        "test:coverage:update-baseline": "sh .Build/vendor/psbits/qa/Resources/Testing/Scripts/runCoverage.sh --update-baseline @additional_args",
        "test:docker": [
            "Composer\\Config::disableProcessTimeout",
            "sh .Build/vendor/psbits/qa/Resources/Testing/Scripts/runDockerTests.sh @additional_args"
        ],
        "test:functional": [
            "php .Build/vendor/psbits/qa/Resources/Testing/renderPhpunitXml.php functional",
            "php -d memory_limit=1G .Build/bin/phpunit -c .Build/phpunit/FunctionalTests.xml"
        ],
        "test:local": [
            "Composer\\Config::disableProcessTimeout",
            "sh .Build/vendor/psbits/qa/Resources/Testing/Scripts/runLocalTests.sh @additional_args"
        ],
        "test:unit": [
            "php .Build/vendor/psbits/qa/Resources/Testing/renderPhpunitXml.php unit",
            "php -d memory_limit=1G .Build/bin/phpunit -c .Build/phpunit/UnitTests.xml"
        ],
        "validate:composer": "composer validate --no-check-publish"
    }
}
