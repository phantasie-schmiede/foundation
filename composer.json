{
    "authors": [
        {
            "email": "dn@phantasie-schmiede.de",
            "name": "Daniel Ablass",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "PSBits\\Foundation\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PSBits\\Foundation\\PhpCsFixer\\Fixer\\": "Build/Quality/php-cs-fixer",
            "PSBits\\Foundation\\Tests\\": "Tests"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "vendor-dir": ".Build/vendor"
    },
    "description": "Configuration framework for TYPO3 extension development",
    "extra": {
        "typo3/cms": {
            "extension-key": "foundation",
            "web-dir": ".Build/public"
        }
    },
    "keywords": [
        "configuration",
        "development",
        "extension",
        "typo3"
    ],
    "license": "GPL-3.0-or-later",
    "name": "psbits/foundation",
    "require": {
        "ext-fileinfo": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-simplexml": "*",
        "php": "^8.3",
        "typo3/cms-core": "^13.4 || ^14.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "helmich/typo3-typoscript-lint": "^3.3",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.2.5",
        "saschaegerer/phpstan-typo3": "^2.1 || ^3.0",
        "typo3/coding-standards": "^0.5.3",
        "typo3/testing-framework": "^9.5"
    },
    "scripts": {
        "analyze:php": "phpstan analyse --configuration=Build/Quality/phpstan.neon.dist --no-progress",
        "audit:composer": "composer audit --abandoned=report",
        "docker:images": [
            "Composer\\Config::disableProcessTimeout",
            "sh Build/Scripts/buildTestImages.sh"
        ],
        "fix:all": [
            "@fix:classes",
            "@fix:htmlxml",
            "@fix:php"
        ],
        "fix:classes": "npm run fix:classes",
        "fix:htmlxml": "npm run fix:htmlxml",
        "fix:php": "php-cs-fixer fix --config=Build/Quality/.php-cs-fixer.dist.php --verbose",
        "lint:all": [
            "@analyze:php",
            "@audit:composer",
            "@lint:classes",
            "@lint:htmlxml",
            "@lint:php",
            "@lint:typoscript",
            "@lint:yaml",
            "@validate:composer"
        ],
        "lint:classes": "npm run lint:classes",
        "lint:htmlxml": "npm run lint:htmlxml",
        "lint:php": "php-cs-fixer fix --config=Build/Quality/.php-cs-fixer.dist.php --dry-run --diff --verbose",
        "lint:typoscript": "typoscript-lint --config=Build/Quality/typoscript-lint.yml --ansi Configuration/TypoScript",
        "lint:yaml": "yamllint -c Build/Quality/.yamllint.yml Build/Quality Configuration",
        "post-install-cmd": [
            "npm install",
            "cp Build/GitHooks/pre-commit .git/hooks/pre-commit"
        ],
        "qa": [
            "@fix:all",
            "@lint:all",
            "@test"
        ],
        "test": [
            "@test:unit",
            "@test:functional"
        ],
        "test:all": [
            "@test:local",
            "@test:docker"
        ],
        "test:coverage": "sh Build/Scripts/runCoverage.sh @additional_args",
        "test:coverage:update-baseline": "sh Build/Scripts/runCoverage.sh --update-baseline @additional_args",
        "test:docker": [
            "Composer\\Config::disableProcessTimeout",
            "sh Build/Scripts/runDockerTests.sh @additional_args"
        ],
        "test:local": [
            "Composer\\Config::disableProcessTimeout",
            "sh Build/Scripts/runLocalTests.sh @additional_args"
        ],
        "test:functional": "php -d memory_limit=1G .Build/bin/phpunit -c Build/phpunit/FunctionalTests.xml",
        "test:unit": "php -d memory_limit=1G .Build/bin/phpunit -c Build/phpunit/UnitTests.xml",
        "validate:composer": "composer validate --no-check-publish"
    },
    "type": "typo3-cms-extension"
}
